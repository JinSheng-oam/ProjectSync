{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectSync",
  "version": "1.0.0",
  "identifier": "com.projectsync.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProjectSync",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/projectsync-v2/32x32.png",
      "icons/projectsync-v2/128x128.png",
      "icons/projectsync-v2/128x128@2x.png",
      "icons/projectsync-v2/icon.ico"
    ],
    "targets": ["nsis", "msi"],
    "shortDescription": "Safe bidirectional project file sync over WebDAV",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./windows/installer-directory.wxs"]
      }
    }
  }
}
